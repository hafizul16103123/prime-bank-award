{
  "openapi": "3.0.0",
  "info": {
    "title": "Prime Bank API",
    "version": "1.0.0",
    "description": "API documentation for Prime Bank application"
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "John Doe" },
          "email": { "type": "string", "format": "email", "example": "john@example.com" },
          "password": { "type": "string", "example": "password123" },
          "role": { "type": "string", "enum": ["ADMIN", "SCHOOL_ADMIN", "STUDENT"], "example": "STUDENT" }
        },
        "required": ["name", "email", "password"]
      },
      "Student": {
        "type": "object",
        "properties": {
          "userId": { "type": "string", "example": "507f1f77bcf86cd799439011" },
          "dateOfBirth": { "type": "string", "format": "date", "example": "2005-05-15" },
          "gender": { "type": "string", "enum": ["MALE", "FEMALE", "OTHER", "PREFER_NOT_TO_SAY"], "example": "MALE" },
          "phoneNumber": { "type": "string", "example": "+1234567890" },
          "email": { "type": "string", "format": "email", "example": "john@example.com" },
          "school": { "type": "string", "example": "ABC High School" },
          "rollNumber": { "type": "string", "example": "12345" },
          "photoUrl": { "type": "string", "example": "https://example.com/photo.jpg" },
          "applyingForLevel": { "type": "string", "enum": ["AS_A2", "CAMBRIDGE_CIE"], "example": "AS_A2" },
          "yearOfExamination": { "type": "number", "example": 2024 },
          "examinationSession": { "type": "string", "enum": ["OCT_NOV", "MAY_JUNE", "FEB_MARCH"], "example": "OCT_NOV" },
          "examinationBoard": { "type": "string", "enum": ["CAMBRIDGE", "EDEXCEL", "AQA", "OCR"], "example": "CAMBRIDGE" },
          "studyGroup": { "type": "string", "enum": ["SCIENCE", "ARTS", "COMMERCE"], "example": "SCIENCE" },
          "oLevelSubjects": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "grade": { "type": "string" }, "paperCode": { "type": "string" } } } },
          "aLevelSubjects": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "grade": { "type": "string" }, "paperCode": { "type": "string" } } } }
        }
      },
      "StudentRegisterRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "John Doe" },
          "email": { "type": "string", "format": "email", "example": "john@example.com" },
          "password": { "type": "string", "example": "password123" },
          "role": { "type": "string", "example": "STUDENT" },
          "dateOfBirth": { "type": "string", "example": "2005-05-15" },
          "gender": { "type": "string", "example": "MALE" },
          "phoneNumber": { "type": "string", "example": "+1234567890" },
          "school": { "type": "string", "example": "ABC High School" },
          "rollNumber": { "type": "string", "example": "12345" },
          "photoUrl": { "type": "string", "example": "https://example.com/photo.jpg" },
          "applyingForLevel": { "type": "string", "example": "AS_A2" },
          "yearOfExamination": { "type": "number", "example": 2024 },
          "examinationSession": { "type": "string", "example": "OCT_NOV" },
          "examinationBoard": { "type": "string", "example": "CAMBRIDGE" },
          "studyGroup": { "type": "string", "example": "SCIENCE" },
          "oLevelSubjects": { "type": "array", "example": [{ "name": "Mathematics", "grade": "A", "paperCode": "4024" }] },
          "aLevelSubjects": { "type": "array", "example": [] }
        },
        "required": ["name", "email", "password", "dateOfBirth", "gender", "phoneNumber", "school", "applyingForLevel", "yearOfExamination", "examinationSession"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email", "example": "john@example.com" },
          "password": { "type": "string", "example": "password123" }
        },
        "required": ["email", "password"]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Login successful" },
          "data": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "email": { "type": "string" }, "role": { "type": "string" }, "token": { "type": "string" } } }
        }
      },
      "RegisterResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "User registered successfully" },
          "data": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "email": { "type": "string" }, "role": { "type": "string" }, "token": { "type": "string" } } }
        }
      },
      "ForgetPasswordRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email", "example": "john@example.com" }
        },
        "required": ["email"]
      },
      "ResetPasswordRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "otp": { "type": "string" },
          "newPassword": { "type": "string" }
        },
        "required": ["email", "otp", "newPassword"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/api/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register new user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/User" },
              "example": { "name": "John Doe", "email": "john@example.com", "password": "password123", "role": "STUDENT" }
            }
          }
        },
        "responses": {
          "201": { "description": "User created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterResponse" } } } },
          "409": { "description": "User already exists" }
        }
      }
    },
    "/api/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": { "email": "john@example.com", "password": "password123" }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } } },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/forget-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Request password reset OTP",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ForgetPasswordRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP sent" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/api/reset-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Reset password with OTP",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResetPasswordRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Password reset successful" },
          "400": { "description": "Invalid or expired OTP" }
        }
      }
    },
    "/api/student-register": {
      "post": {
        "tags": ["Student"],
        "summary": "Register new student",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StudentRegisterRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Student registered" },
          "409": { "description": "User already exists" }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "tags": ["Admin"],
        "summary": "Get all users (Admin only)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Users found" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/school-admin/students": {
      "get": {
        "tags": ["School Admin"],
        "summary": "Get all students (School Admin & Admin)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Students found" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/student/profile": {
      "get": {
        "tags": ["Student"],
        "summary": "Get student profile (Student only)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Profile found" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/api/public/info": {
      "get": {
        "tags": ["Public"],
        "summary": "Get public API information",
        "responses": {
          "200": { "description": "Success" }
        }
      }
    }
  }
}